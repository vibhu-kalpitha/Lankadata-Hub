# LankaData Hub - FastAPI Service Environment Configuration
# Copy this file to .env and fill in your actual values

# PostgreSQL Connection (Docker container connects to postgres service name)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/lankadata_hub

# Application Settings
APP_ENV=production
APP_DEBUG=false
APP_PORT=8001

# CORS Origins (comma-separated or wildcard '*')
CORS_ORIGINS=*
